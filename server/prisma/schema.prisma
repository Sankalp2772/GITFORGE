generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum MemberRole {
  ADMIN
  WRITE
  READ
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum PRStatus {
  OPEN
  CLOSED
  MERGED
}

enum ReviewState {
  COMMENTED
  APPROVED
  CHANGES_REQUESTED
}

enum IssueStatus {
  OPEN
  CLOSED
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  avatar       String?
  bio          String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  ownedRepositories    Repository[]           @relation("RepositoryOwner")
  memberships          RepositoryMember[]     @relation("UserMemberships")
  receivedInvitations  RepositoryInvitation[] @relation("ReceivedInvitations")
  sentInvitations      RepositoryInvitation[] @relation("SentInvitations")
  pullRequests         PullRequest[]          @relation("UserPullRequests")
  prReviews            PullRequestReview[]    @relation("UserPRReviews")
  prComments           PullRequestComment[]   @relation("UserPRComments")
  issues               Issue[]                @relation("UserCreatedIssues")
  assignedIssues       Issue[]                @relation("UserAssignedIssues")
  issueComments        IssueComment[]         @relation("UserIssueComments")
  notifications        Notification[]         @relation("UserNotifications")
  activityLogs         ActivityLog[]          @relation("UserActivities")

  @@map("users")
}

model Repository {
  id            String     @id @default(uuid())
  name          String
  description   String?    @db.Text
  visibility    Visibility @default(PUBLIC)
  ownerId       String
  defaultBranch String     @default("main")
  storagePath   String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  owner         User       @relation("RepositoryOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Relationships
  members       RepositoryMember[]
  invitations   RepositoryInvitation[]
  branches      Branch[]
  pullRequests  PullRequest[]
  issues        Issue[]
  labels        Label[]
  activityLogs  ActivityLog[]

  @@unique([ownerId, name])
  @@index([ownerId])
  @@index([visibility])
  @@map("repositories")
}

model RepositoryMember {
  id           String     @id @default(uuid())
  repositoryId String
  userId       String
  role         MemberRole @default(READ)
  joinedAt     DateTime   @default(now())

  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user         User       @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, userId])
  @@index([repositoryId])
  @@index([userId])
  @@map("repository_members")
}

model RepositoryInvitation {
  id           String           @id @default(uuid())
  repositoryId String
  invitedUserId String
  invitedById  String
  role         MemberRole       @default(READ)
  status       InvitationStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  repository   Repository       @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  invitedUser  User             @relation("ReceivedInvitations", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy    User             @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([invitedUserId])
  @@index([invitedById])
  @@index([status])
  @@map("repository_invitations")
}

model Branch {
  id           String     @id @default(uuid())
  repositoryId String
  name         String
  commitSha    String
  isDefault    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, name])
  @@index([repositoryId])
  @@map("branches")
}

model PullRequest {
  id           String       @id @default(uuid())
  number       Int
  repositoryId String
  authorId     String
  sourceBranch String
  targetBranch String
  title        String
  description  String?      @db.Text
  status       PRStatus     @default(OPEN)
  mergedAt     DateTime?
  mergedBy     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  author       User         @relation("UserPullRequests", fields: [authorId], references: [id], onDelete: Cascade)

  reviews      PullRequestReview[]
  comments     PullRequestComment[]

  @@unique([repositoryId, number])
  @@index([repositoryId])
  @@index([authorId])
  @@index([status])
  @@map("pull_requests")
}

model PullRequestReview {
  id            String      @id @default(uuid())
  pullRequestId String
  reviewerId    String
  state         ReviewState @default(COMMENTED)
  body          String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  pullRequest   PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  reviewer      User        @relation("UserPRReviews", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([pullRequestId])
  @@index([reviewerId])
  @@map("pull_request_reviews")
}

model PullRequestComment {
  id            String      @id @default(uuid())
  pullRequestId String
  authorId      String
  content       String      @db.Text
  diffPath      String?
  diffLine      Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  pullRequest   PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  author        User        @relation("UserPRComments", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([pullRequestId])
  @@index([authorId])
  @@map("pull_request_comments")
}

model Issue {
  id           String       @id @default(uuid())
  number       Int
  repositoryId String
  authorId     String
  assigneeId   String?
  title        String
  description  String?      @db.Text
  status       IssueStatus  @default(OPEN)
  closedAt     DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  author       User         @relation("UserCreatedIssues", fields: [authorId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("UserAssignedIssues", fields: [assigneeId], references: [id], onDelete: SetNull)

  comments     IssueComment[]
  labels       Label[]

  @@unique([repositoryId, number])
  @@index([repositoryId])
  @@index([authorId])
  @@index([assigneeId])
  @@index([status])
  @@map("issues")
}

model IssueComment {
  id        String   @id @default(uuid())
  issueId   String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author    User     @relation("UserIssueComments", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([authorId])
  @@map("issue_comments")
}

model Label {
  id           String      @id @default(uuid())
  repositoryId String
  name         String
  color        String      @default("#6b7280")
  description  String?
  createdAt    DateTime    @default(now())

  repository   Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  issues       Issue[]

  @@unique([repositoryId, name])
  @@index([repositoryId])
  @@map("labels")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String   @db.Text
  type      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model ActivityLog {
  id           String      @id @default(uuid())
  repositoryId String
  userId       String
  action       String
  details      String?     @db.Text
  createdAt    DateTime    @default(now())

  repository   Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user         User        @relation("UserActivities", fields: [userId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}
